# Copy this file to .env for local development. Never commit the real .env.

# Your Supabase project's connection string (Project Settings > Database > Connection string > URI).
# Use the "Session pooler" connection string, not "Direct connection" — Render's
# free instance connects over IPv4 only, and Supabase's direct connection is IPv6-only.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
INTERNAL_SECRET=
ENCRYPTION_KEY=

# sandbox while testing with fake data, production once you're on a Plaid Trial plan
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

PORT=3000
