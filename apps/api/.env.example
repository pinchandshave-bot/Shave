```dotenv
# Copy this file to .env for local development.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# Supabase PostgreSQL connection string.
#
# Use the "Session pooler" connection string:
# Project Settings > Database > Connection string > URI
#
# Render's free instance connects over IPv4, while Supabase's direct
# connection may require IPv6.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres


# ---------------------------------------------------------------------------
# APPLICATION SECURITY
# ---------------------------------------------------------------------------

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Internal API / scheduled-job authentication secret.
INTERNAL_SECRET=

# 32-byte encryption key used for sensitive financial credentials.
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# PLAID
# ---------------------------------------------------------------------------

# Plaid environment.
#
# sandbox = Plaid development/testing environment
# production = real financial institutions and real authorized financial data
PLAID_ENV=sandbox

PLAID_CLIENT_ID=
PLAID_SECRET=

# Public HTTPS endpoint that receives Plaid webhooks.
#
# This must be reachable by Plaid.
#
# Local development requires a publicly reachable HTTPS tunnel.
# Production should use the deployed iBag API HTTPS endpoint.
PLAID_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------

PORT=3000
```
